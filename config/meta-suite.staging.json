{
  "version": 3,
  "owner_line": "owner-main",
  "integration": {
    "inline_chat": true,
    "surface": "ogenic-web+ogenic-app",
    "source_of_truth": "D1 owner-main",
    "ui_label": "Meta Facebook"
  },
  "scope": {
    "primary": ["line", "meta-facebook-messenger"],
    "optional": ["meta-instagram"],
    "inactive": ["meta-whatsapp", "meta-threads", "meta-muse"],
    "note": "Primary sales channels are LINE OA and Facebook Page/Messenger. Instagram is optional only when linked/discoverable; other Meta products are not part of the active sales scope."
  },
  "policy": {
    "read_first": true,
    "no_raw_secrets": true,
    "outbound_side_effects_require_approval": true,
    "paid_api_fallback_requires_owner_choice": true
  },
  "modules": [
    {
      "id": "meta-facebook-messenger",
      "label": "Facebook Page + Messenger",
      "family": "Meta",
      "priority": "primary",
      "mode": "Graph API + Webhooks",
      "credentials": ["META_PAGE_ACCESS_TOKEN", "META_APP_SECRET", "META_VERIFY_TOKEN"],
      "permissions": ["pages_messaging"],
      "safe_probe": "GET /me?fields=id,name",
      "outbound": "approval-gated"
    },
    {
      "id": "meta-instagram",
      "label": "Instagram Professional + Messaging",
      "family": "Meta",
      "priority": "optional",
      "required": false,
      "auto_discover_from_facebook_page": true,
      "mode": "Instagram Graph API + Webhooks",
      "credential_aliases": ["INSTAGRAM_ACCESS_TOKEN", "IG_ACCESS_TOKEN", "META_PAGE_ACCESS_TOKEN"],
      "asset_aliases": ["INSTAGRAM_BUSINESS_ACCOUNT_ID", "META_IG_USER_ID", "IG_USER_ID"],
      "permissions": ["instagram_business_basic", "instagram_business_manage_messages"],
      "outbound": "approval-gated"
    }
  ]
}
