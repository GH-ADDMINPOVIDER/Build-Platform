{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ogenic-phase-vi-staging",
  "main": "worker/entry-connectors.ts",
  "compatibility_date": "2026-09-06",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "observability": {
    "enabled": true
  },
  "routes": [
    {
      "pattern": "wave.ogenicchocolate.com",
      "custom_domain": true
    }
  ],
  "browser": {
    "binding": "BROWSER"
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/workflows/*",
      "/runs/*",
      "/hooks/*"
    ]
  },
  "vars": {
    "OGENIC_PHASE": "VI",
    "OGENIC_RUNTIME": "cloudflare",
    "OGENIC_GITHUB_REPO": "Ogenicchocolate21debug/Build-Platform",
    "OGENIC_GITHUB_BRANCH": "phase-vi-provider-incentive-metering"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ogenic-phase-vi-staging",
      "database_id": "b4ac3a33-df80-47cf-8e75-7574e025b87b",
      "migrations_dir": "database/migrations"
    }
  ],
  "keep_vars": true
}
