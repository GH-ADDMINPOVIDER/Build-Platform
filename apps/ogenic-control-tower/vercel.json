{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/", "destination": "/api/health" },
    { "source": "/mcp", "destination": "/api/mcp" },
    { "source": "/healthz", "destination": "/api/health" }
  ],
  "functions": {
    "api/mcp.js": {
      "includeFiles": "public/control-tower.html",
      "maxDuration": 60
    },
    "api/health.js": {
      "includeFiles": "public/control-tower.html"
    }
  }
}
