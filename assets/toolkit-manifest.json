{
  "name": "Developer System-Bootstrap Ops",
  "version": "0.1.0",
  "command_prefix": "/WF",
  "mode": "cloud-first",
  "pipeline": ["inspect", "resolve", "secret_check", "develop", "build", "audit", "deploy", "verify", "save"],
  "surfaces": ["Google Drive", "GitHub", "Notion", "Shopify", "Cloudflare", "Infisical"],
  "secret_policy": "metadata-only-outside-secret-manager",
  "duplicate_policy": "category+filename+mime_type+size",
  "sync_policy": "copy-if-missing-version-on-conflict"
}
